[Version]
Signature   = "$WINDOWS NT$"
Class       = SoftwareComponent
ClassGuid   = {5c4c3332-344d-483c-8739-259e934c9cc8}
Provider    = %ProviderName%
DriverVer = 02/28/2023,1.0.1.3
CatalogFile = DiracHsa.cat

[SourceDisksNames]
1 = %DiskId1%

[SourceDisksFiles]

[DestinationDirs]

[SignatureAttributes]

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%MfgName% = HsaComponents,NTamd64.10.0...17763

[HsaComponents.NTamd64.10.0...17763]
%Hsa.ComponentDesc% = HsaComponent_Install,SWC\VEN_DIRAC&HID_0001

[HsaComponent_Install]
Include   = wdmaudio.inf

[HsaComponent_Install.Services]
AddService = ,2    ; no function driver

[HsaComponent_Install.Software]
AddSoftware=DiracAudioManager,,Dirac_Audio_Manager_Install

[Dirac_Audio_Manager_Install]
SoftwareType=2
SoftwareID=pfn://DrivewintechTechnologyCo.DiracAudoManager_e7q8crqfywnwm
                 
[Strings]
ProviderName      = "Drivewintech Co., Ltd."
MfgName           = "Dirac Research AB"
Hsa.ComponentDesc = "Dirac Hardware Support App"
DiskId1           = "Dirac HSA Installation Disk"

REG_BINARY = 0x00000001
REG_DWORD = 0x00010001
REG_MULTI_SZ = 0x00010000
